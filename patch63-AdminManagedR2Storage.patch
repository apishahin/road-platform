                 $value = DB::table('settings')->where('key', 'evidence_storage')->value('value');
                 if ($value !== null && isset(self::OPTIONS[$value])) {
-                    self::$stored = $value;
+                    return $value;
                 }
             }
         } catch (\Throwable) {
-            // database not ready: fall back to .env
+            // Database not ready: fall back to configuration values.
         }
 
-        return self::$stored;
