 public/maps/bangladesh-districts.geojson |  1 +
 resources/css/app.css                    | 18 ++++++
 resources/js/home-map.js                 | 70 +++++++++++++++++++++---
 resources/views/home.blade.php           |  3 +
 tests/Feature/HomePageTest.php           |  8 +++
 tests/Unit/BangladeshDistrictMapTest.php | 29 ++++++++++
 7 files changed, 142 insertions(+), 9 deletions(-)
 create mode 100644 public/maps/bangladesh-districts.geojson
